# --- Server ---
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173
MONGO_URI=mongodb://localhost:27017/resumematch
REDIS_URL=redis://localhost:6379

# --- LLM ---
# anthropic (default) | openai | fake (offline demo model, no API key, not real analysis)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
PARSE_MODEL=claude-haiku-5-5      # cheap model: parseResume, parseJD
SCORE_MODEL=claude-sonnet-5-5     # stronger model: matchRequirements, scoreDimensions
# Only when LLM_PROVIDER=openai:
OPENAI_API_KEY=
OPENAI_PARSE_MODEL=gpt-4.1-mini
OPENAI_SCORE_MODEL=gpt-4.1
# Cost tracking for models not in the built-in table, USD per 1M tokens "input,output":
# PRICE_GPT_4_1=2,8

# Eval-only LLM judge for question relevance (must differ from SCORE_MODEL).
# Default: OpenAI gpt-4.1 if OPENAI_API_KEY is set, else claude-opus-5-5.
# JUDGE_MODEL=

PROMPT_VERSION=v1
WORKER_CONCURRENCY=2

# --- Tracing (optional) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
