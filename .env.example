# --- Server ---
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173
MONGO_URI=mongodb://localhost:27017/resumematch
REDIS_URL=redis://localhost:6379

# --- LLM (Phase 2+) ---
LLM_PROVIDER=anthropic            # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PARSE_MODEL=claude-haiku-5-5      # cheap model for parsing
SCORE_MODEL=claude-sonnet-5-5     # stronger model for scoring/questions

# --- Tracing (optional) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
